# === SECURITY & AUTHENTICATION ===
# JWT Secret for token generation and verification
# Generate a secure random string: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-key-change-this-in-production

# Admin password for accessing /api/admin/owners endpoint
# Use a strong random password with uppercase, lowercase, digits, and special characters
ADMIN_PASSWORD=your-secure-admin-password-change-this

# === DATABASE ===
# PostgreSQL database connection string
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost/faces_db
# If you wanted to test with SQLite, you could change this to:
# DATABASE_URL=sqlite+aiosqlite:///./faces.db

# === SUPABASE (Cloud Storage for Face Images) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# === EMAIL NOTIFICATIONS ===
# Gmail SMTP credentials for signup notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Admin email to receive signup notifications
ADMIN_EMAIL=admin@example.com

# === CORS CONFIGURATION ===
# Comma-separated list of allowed origins for cross-origin requests
# Example: http://localhost:5173,https://example.com,https://app.example.com
ALLOWED_ORIGINS=http://localhost:5173

# === PERFORMANCE TUNING ===
# Job queue timeout in seconds - drop frames if queue is full to maintain FPS
# Default: 0.5 seconds
SENTINEL_JOB_QUEUE_TIMEOUT=0.5

# === OPTIONAL: GOOGLE CLOUD VISION (Alternative to MediaPipe for Face Detection) ===
# Path to Google Cloud service account JSON file (if using Vision API)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# === OPTIONAL: WHATSAPP GATEWAY ===
# WhatsApp gateway service connection details
# WHATSAPP_GATEWAY_URL=http://localhost:9000
